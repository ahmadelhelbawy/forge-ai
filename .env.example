# FORGE — environment for `docker compose` (copy to .env) or a local run.
# NEVER commit .env. Every variable is optional: with none set, FORGE starts,
# and you add a provider key in Settings (stored encrypted in the data volume).

# ── Model provider (configure at least one, here or in Settings) ─────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # or any OpenAI-compatible gateway
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# OpenCode Go (Zen gateway):
# FORGE_API_KEY=
# FORGE_BASE_URL=https://opencode.ai/zen/go/v1
# Default model id (otherwise the provider's default):
# FORGE_MODEL=

# ── Security ─────────────────────────────────────────────────────────────────
# Encrypts provider keys saved from Settings (AES-256-GCM); >= 16 characters.
# Unset: FORGE generates a random key in <data>/app.secret (mode 0600).
# Set it so a copied volume or backup does not carry the key that decrypts
# your provider keys. Changing it later makes saved keys unreadable (re-enter them).
# Generate one with:  openssl rand -base64 32
# FORGE_APP_SECRET=

# Extra host names FORGE answers on (behind an authenticating reverse proxy only).
# localhost and 127.0.0.1 are always allowed.
# FORGE_ALLOWED_HOSTS=forge.example.internal

# ── Repository binding (optional) ────────────────────────────────────────────
# Directories a conversation may bind; binding is refused when unset.
# In Docker these are CONTAINER paths — mount the host directory read-only in
# compose.yaml (e.g. ${HOME}/src:/repos:ro) and set:
# FORGE_REPO_ROOTS=/repos

# ── Host port (compose only) ─────────────────────────────────────────────────
# FORGE_PORT=3000
