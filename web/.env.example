# FORGE web — copy to web/.env.local for dev, or set as environment in deploy.
# NEVER commit real keys. Only the server reads these; nothing here reaches the browser.

# --- Model providers (configure at least one) ---
# Anthropic direct API:
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible endpoint (OpenAI itself or a gateway such as OpenCode Zen):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Legacy FORGE names. They belong to ONE provider, never several: OpenCode Go
# when FORGE_BASE_URL is an opencode.ai URL, Anthropic when
# FORGE_PROVIDER=anthropic, otherwise the OpenAI-compatible provider.
# FORGE_API_KEY=
# FORGE_BASE_URL=https://opencode.ai/zen/go/v1
# FORGE_PROVIDER=anthropic
# Default model id (provider default otherwise):
# FORGE_MODEL=kimi-k3
# Optional gateway routing header: FORGE sends a random UUID under this name.
# Needed by some gateways (e.g. OpenCode Zen requires x-opencode-session).
# FORGE_SESSION_HEADER=x-opencode-session

# --- App ---
# PORT=3000
# Interface to listen on. Loopback by default: FORGE has NO login, so only
# widen this behind an authenticating proxy (see web/DEPLOY.md).
# FORGE_HOST=127.0.0.1
# FORGE_DATA_DIR=./data
# Encrypts provider keys saved from Settings (AES-256-GCM), >= 16 characters.
# Unset: FORGE generates a random key in <data dir>/app.secret (mode 0600).
# Set it to keep the key outside the data directory (and its backups).
# FORGE_APP_SECRET=
# Directories a conversation may bind as its repository (unset = refused).
# FORGE_REPO_ROOTS=/home/me/src
