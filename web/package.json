{
  "name": "forge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter forge run build && next dev --hostname ${FORGE_HOST:-127.0.0.1} --port ${PORT:-3000}",
    "build": "pnpm --filter forge run build && next build && node scripts/postbuild.mjs",
    "start": "next start --hostname ${FORGE_HOST:-127.0.0.1} --port ${PORT:-3000}"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ai": "^7.0.101",
    "clsx": "^2.1.1",
    "forge": "workspace:*",
    "lucide-react": "^0.469.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "playwright-core": "1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
