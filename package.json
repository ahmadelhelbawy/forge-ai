{
  "name": "forge",
  "version": "0.1.0-alpha.0",
  "description": "AI Intent & Context Compiler — lowers human intent into a provider-independent Task IR and compiles it into agent-specific Execution Packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadelhelbawy/forge-ai.git"
  },
  "homepage": "https://github.com/ahmadelhelbawy/forge-ai#readme",
  "bugs": {
    "url": "https://github.com/ahmadelhelbawy/forge-ai/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ir": "./dist/ir/index.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "profiles",
    "schema",
    "strategies"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/intent/prompt.md dist/intent/prompt.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:emit": "tsx scripts/emit-schema.ts",
    "schema:check": "tsx scripts/emit-schema.ts --check",
    "forge": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^15.0.0",
    "gpt-tokenizer": "4.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "bin": {
    "forge": "./dist/cli/index.js"
  },
  "packageManager": "pnpm@11.20.0"
}
