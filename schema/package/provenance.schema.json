{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schema/package/1.0/provenance.json",
  "title": "FORGE Execution Package — provenance.json",
  "description": "Published contract for provenance.json inside an Execution Package (spec.md §11). Consuming a package requires only JSON parsing and this schema (PK-R8).",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "source_ref"
        ]
      }
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "trust": {
            "type": "string"
          },
          "justifies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ref_id",
          "content_hash",
          "trust",
          "justifies"
        ]
      }
    },
    "materialization": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dropped_context": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "topology_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "nodes",
    "context_refs",
    "materialization",
    "dropped_context",
    "topology_gaps"
  ]
}
