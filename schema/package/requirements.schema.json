{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schema/package/1.0/requirements.json",
  "title": "FORGE Execution Package — requirements.json",
  "description": "Published contract for requirements.json inside an Execution Package (spec.md §11). Consuming a package requires only JSON parsing and this schema (PK-R8).",
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^req-[0-9a-f]{12}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "user_stated",
              "inferred"
            ]
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "pinned",
              "goal",
              "constraint",
              "non_goal",
              "deliverable"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "origin",
          "node_id",
          "kind"
        ]
      }
    }
  },
  "required": [
    "requirements"
  ]
}
