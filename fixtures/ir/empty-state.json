{
  "ir_version": "1.0",
  "semantic_hash": null,

  "objective": {
    "statement": "Add an empty state to the search results view for when a query returns nothing",
    "kind": "feature",
    "success_definition": "A user who searches for something with no matches sees a clear, actionable empty state instead of a blank panel",
    "source_ref": "user_input"
  },

  "goals": [
    {
      "id": "g1",
      "statement": "Show a purpose-built empty state when a search returns zero results",
      "priority": "must",
      "acceptance": [
        "A search with no matches renders the empty state rather than an empty list",
        "The empty state names what was searched for"
      ],
      "source_ref": "user_input"
    },
    {
      "id": "g2",
      "statement": "Offer the user a next step from the empty state",
      "priority": "should",
      "acceptance": [
        "The empty state offers at least one action, such as clearing filters"
      ],
      "source_ref": "user_input"
    }
  ],

  "constraints": [
    {
      "id": "c1",
      "kind": "architectural",
      "hardness": "hard",
      "statement": "Do not change the search results data-fetching layer or its public props",
      "source_ref": "user_input"
    },
    {
      "id": "c2",
      "kind": "scope",
      "hardness": "hard",
      "statement": "Do not introduce a new dependency for this",
      "source_ref": "user_input"
    },
    {
      "id": "c3",
      "kind": "stylistic",
      "hardness": "soft",
      "statement": "Use the existing spacing and typography tokens rather than literal values",
      "source_ref": "ctx3"
    }
  ],

  "non_goals": [
    {
      "id": "n1",
      "statement": "Redesigning the populated results list",
      "source_ref": "user_input"
    },
    {
      "id": "n2",
      "statement": "Adding search suggestions or autocomplete",
      "source_ref": "user_input"
    }
  ],

  "scope": {
