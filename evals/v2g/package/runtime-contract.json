{
  "declares_only": true,
  "grants": null,
  "required_capabilities": [
    "fs_read",
    "fs_write",
    "shell",
    "run_tests",
    "git_history"
  ],
  "target": {
    "id": "claude-code",
    "version": "2026.9.1",
    "tools": [
      "glob",
      "grep",
      "read",
      "agentic_subsearch"
    ],
    "autonomy": "high",
    "permission_model": "per-tool-prompt"
  },
  "network_policy": "none",
  "filesystem_scope": {
    "include": [
      "src/auth/**",
      "src/lib/session/**"
    ],
    "exclude": [
      "**/*.snap",
      "dist/**"
    ]
  },
  "blast_radius": "module",
  "repository": {
    "commit": null,
    "dirty": null
  },
  "degradations": []
}
